                name: "Festa della Venuta (Loreto Religious Spillover)",
                period: "9 - 10 Dicembre 2025",
                target: "Pellegrini, Turismo Religioso",
                adrMult: "+40%",
                minStay: "2 Notti",
                type: "cultura"
            }
        ];

        let losChartInstance = null;
        let adrChartInstance = null;

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            initLosChart();
            initAdrChart();
            renderEventsTable(eventsList);
            calculateROI();
        });

        // Tab Navigation
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById(`btn-${tabId}`).classList.add('active');
        }

        // Init Chart 1: Length of Stay
        function initLosChart() {
            const ctx = document.getElementById('losChart').getContext('2d');
            losChartInstance = new Chart(ctx, {
                type: 'bar',
                data: losData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` Permanenza Media: ${context.raw} notti`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: 'Notti per Soggiorno' }
                        }
                    }
                }
            });
        }

        // Init Chart 2: ADR Trends
        function initAdrChart() {
            const ctx = document.getElementById('adrChart').getContext('2d');
            adrChartInstance = new Chart(ctx, {
                type: 'line',
                data: adrDataFull,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.dataset.label}: ${context.raw} € / notte`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            title: { display: true, text: 'Tariffa Media Giornaliera (€)' }
                        }
                    }
                }
            });
        }

        // Filter ADR Chart Dataset
        function updateAdrChart() {
            const selected = document.getElementById('propertyTypeSelect').value;
            if (selected === 'all') {
                adrChartInstance.data.datasets = adrDataFull.datasets;
            } else {
                const map = { mono: 0, bilo: 1, trilo: 2, quadri: 3, villa: 4 };
                const idx = map[selected];
                adrChartInstance.data.datasets = [adrDataFull.datasets[idx]];
            }
            adrChartInstance.update();
        }

        // Dynamic ROI Calculator Logic
        function calculateROI() {
            const model = document.getElementById('roiModel').value;
            const type = document.getElementById('roiType').value;
            const annualCostInput = parseFloat(document.getElementById('roiAnnualCost').value) || 0;
            const adr = parseFloat(document.getElementById('roiAdr').value);
            const occPct = parseFloat(document.getElementById('roiOcc').value) / 100;

            document.getElementById('adrVal').innerText = adr + " €";
            document.getElementById('occVal').innerText = Math.round(occPct * 100) + "%";

            // Update Input Labels based on model
            const costLabel = document.getElementById('costInputLabel');
            const rowFixedCost = document.getElementById('rowFixedCost');

            if (model === 'r2r') {
                costLabel.innerText = "Canone Annuo Locazione (€/anno)";
                rowFixedCost.style.display = "flex";
            } else if (model === 'btl') {
                costLabel.innerText = "Costo Capitale Acquisto/Ristrutt. (€)";
                rowFixedCost.style.display = "flex";
            } else if (model === 'pm') {
                costLabel.innerText = "Fee Gestione PM (%)";
                rowFixedCost.style.display = "none";
            }

            // Days sold
            const daysSold = Math.round(365 * occPct);
            const grossRevenue = daysSold * adr;

            let operatingCosts = grossRevenue * 0.28; // OTA commission, cleanings, utilities (~28%)
            let noi = 0;
            let roiText = "";

            if (model === 'r2r') {
                noi = grossRevenue - operatingCosts - annualCostInput;
                const initialSetup = 12000; // Average setup cost for furniture, deposit, CIN equipment
                const roiVal = ((noi / initialSetup) * 100).toFixed(0);
                roiText = `~${roiVal}% (Cash-on-Cash su cap. d'avvio ~12k €)`;
                document.getElementById('resCostoFisso').innerText = `-${annualCostInput.toLocaleString('it-IT')} €`;
            } else if (model === 'pm') {
                const pmFeePct = annualCostInput > 100 ? 20 : annualCostInput; // Handle percentage input
                const pmFee = grossRevenue * (pmFeePct / 100);
                noi = pmFee - (grossRevenue * 0.05); // Direct costs
                roiText = `~100% (Margine puro su fee di gestione ${pmFeePct}%)`;
            } else if (model === 'btl') {
                noi = grossRevenue - operatingCosts; // Property tax, maintenance
                const capitalInvested = annualCostInput > 0 ? annualCostInput : 180000;
                const roiVal = ((noi / capitalInvested) * 100).toFixed(1);
                roiText = `~${roiVal}% Yield Netto sul Capitale`;
                document.getElementById('resCostoFisso').innerText = `Immobile / Ammortamento`;
            }

            // Update UI
            document.getElementById('resNotti').innerText = `${daysSold} notti`;
            document.getElementById('resFatturato').innerText = `${Math.round(grossRevenue).toLocaleString('it-IT')} €`;
            document.getElementById('resCostiOp').innerText = `-${Math.round(operatingCosts).toLocaleString('it-IT')} €`;
            document.getElementById('resNOI').innerText = `${Math.round(noi).toLocaleString('it-IT')} €`;
            document.getElementById('resROI').innerText = roiText;
        }

        // Render Events Table
        function renderEventsTable(data) {
            const tbody = document.getElementById('eventsTableBody');
            tbody.innerHTML = '';

            data.forEach(ev => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-warmbg transition-colors";
                tr.innerHTML = `
                    <td class="p-3.5 font-bold text-navy">${ev.name}</td>
                    <td class="p-3.5 text-gray-600">${ev.period}</td>
                    <td class="p-3.5"><span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-[10px] font-semibold">${ev.target}</span></td>
                    <td class="p-3.5 font-bold text-amber">${ev.adrMult}</td>
                    <td class="p-3.5 font-semibold text-teal">${ev.minStay}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Filter Events Table
        function filterEvents(category) {
            if (category === 'all') {
                renderEventsTable(eventsList);
            } else {
                const filtered = eventsList.filter(e => e.type === category);
                renderEventsTable(filtered);
            }
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisi di Mercato Immobiliare Turistico - Porto Recanati 2025</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Font Awesome CSS CDN (for icon fonts) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        warmbg: '#FAF8F5',
                        warmcard: '#FFFFFF',
                        warmborder: '#E8E2D5',
                        navy: '#1E3A8A',
                        teal: '#0D9488',
                        amber: '#D97706',
                        darkneutral: '#1F2937',
                        lightneutral: '#F3F4F6'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #FAF8F5;
            color: #1F2937;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 650px;
            margin-left: auto;
            margin-right: auto;
            height: 320px;
            max-height: 400px;
        }
        @media (min-width: 768px) {
            .chart-container {
                height: 360px;
            }
        }
        .tab-btn.active {
            border-bottom: 3px solid #0D9488;
            color: #0D9488;
            font-weight: 700;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #F1F1F1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 3px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col custom-scrollbar">

    <!-- Chosen Palette: Warm Sand & Coastal Slate (Background: #FAF8F5, Primary Navy: #1E3A8A, Accent Amber: #D97706, Secondary Teal: #0D9488, Dark Neutral: #1F2937) -->

    <!-- Application Structure Plan:
        1. Top Bar & Header: Strategic summary, key market KPIs (Presenze, Permanenza Media 6.41 notti, Growth rate, Target Yield).
        2. Main Navigation Tabs:
           - Tab 1: Macro Flussi & Territorio (Arrivi, Presenze, Permanenza media comparata con Chart.js, Provenienze).
           - Tab 2: Tipologie & Calcolatore ROI (Analisi ADR per tipologia, simulatore finanziario dinamico Rent-to-Rent vs Buy-to-Let vs PM).
           - Tab 3: Vulnerabilità & Killer Features (Punti critici competitors, soluzioni hardware/software come insonorizzazione e ZTL).
           - Tab 4: Calendario Pricing Dinamico (Eventi 2025/2026 con moltiplicatori ADR e minimum stay).
           - Tab 5: Quadro Normativo & Contratti (Guida CIN, Sanzioni, Contratto 4+4 vs 3+2, Tassa Staytour).
           - Tab 6: Action Plan 5 Mosse (Roadmap operativa per l'investitore).
        3. Dynamic State Management: JavaScript handle calculations, tab changes, dynamic chart rendering, interactive ROI adjustments.
    -->

    <!-- Visualization & Content Choices:
        - Flussi Comparati: Chart.js Bar Chart per mostrare la Length of Stay (LOS) imbattibile di Porto Recanati (6.41 notti) rispetto a Numana, Senigallia e Civitanova Marche.
        - Stagionalità e ADR: Chart.js Line/Bar Chart multilinea per confrontare le tariffe medie giornaliere (Bassa, Media, Alta stagione) tra Monolocali, Bilocali, Trilocali e Ville.
        - Calcolatore ROI: Tool interattivo in Vanilla JS con slider e tendine per calcolare NOI lordo e netto basato sul modello di business selezionato.
        - Vulnerabilità: Grid interattiva con card a scomparsa per analizzare la Ferrovia, ZTL, Gestione Amatoriale e Hotel House.
        - Calendario Eventi: Tabella con filtri dinamici per mese e tipologia di evento.
        - Requisiti Normativi: Checklist interattiva di conformità per il rilascio del CIN 2025.
        - Structural Rationale: Struttura pensata per accompagnare l'investitore dalla macro-analisi di mercato fino all'esecuzione del business plan.
    -->

    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->

    <!-- HEADER / HERO -->
    <header class="bg-navy text-white border-b border-warmborder sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-teal text-white p-2.5 rounded-lg shadow font-bold text-xl">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold tracking-tight text-white">Porto Recanati Invest 2025</h1>
                    <p class="text-xs text-blue-200">Analisi Strategica e Intelligence per l'Investimento Immobiliare Turistico</p>
                </div>
            </div>
            
            <!-- Quick Indicators -->
            <div class="flex items-center space-x-4 bg-blue-900/60 px-4 py-2 rounded-lg text-xs md:text-sm border border-blue-700/50">
                <div class="text-center">
                    <span class="block text-blue-300 text-[10px] uppercase font-semibold">Presenze 2024</span>
                    <span class="font-bold text-white">457.150</span>
                </div>
                <div class="h-6 w-px bg-blue-700"></div>
                <div class="text-center">
                    <span class="block text-blue-300 text-[10px] uppercase font-semibold">Permanenza Media</span>
                    <span class="font-bold text-amber-400">6,41 Notti</span>
                </div>
                <div class="h-6 w-px bg-blue-700"></div>
                <div class="text-center">
                    <span class="block text-blue-300 text-[10px] uppercase font-semibold">Top Asset</span>
                    <span class="font-bold text-teal-300">Trilocale</span>
                </div>
            </div>
        </div>

        <!-- NAVIGATION TABS -->
        <nav class="bg-white text-darkneutral border-t border-warmborder shadow-inner">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto space-x-2 md:space-x-6 text-sm font-medium custom-scrollbar">
                <button onclick="switchTab('tab-flussi')" id="btn-tab-flussi" class="tab-btn active py-3 px-2 whitespace-nowrap focus:outline-none transition-colors">
                    <i class="fa-solid fa-chart-pie mr-1.5"></i> Flussi & Mercato
                </button>
                <button onclick="switchTab('tab-tipologie')" id="btn-tab-tipologie" class="tab-btn py-3 px-2 whitespace-nowrap focus:outline-none transition-colors">
                    <i class="fa-solid fa-calculator mr-1.5"></i> Tipologie & Calcolatore ROI
                </button>
                <button onclick="switchTab('tab-vulnerabilita')" id="btn-tab-vulnerabilita" class="tab-btn py-3 px-2 whitespace-nowrap focus:outline-none transition-colors">
                    <i class="fa-solid fa-shield-halved mr-1.5"></i> Competitor & Vulnerabilità
                </button>
                <button onclick="switchTab('tab-calendario')" id="btn-tab-calendario" class="tab-btn py-3 px-2 whitespace-nowrap focus:outline-none transition-colors">
                    <i class="fa-regular fa-calendar-days mr-1.5"></i> Calendario Pricing 2025
                </button>
                <button onclick="switchTab('tab-normativa')" id="btn-tab-normativa" class="tab-btn py-3 px-2 whitespace-nowrap focus:outline-none transition-colors">
                    <i class="fa-solid fa-gavel mr-1.5"></i> Quadro Normativo & CIN
                </button>
                <button onclick="switchTab('tab-actionplan')" id="btn-tab-actionplan" class="tab-btn py-3 px-2 whitespace-nowrap focus:outline-none transition-colors">
                    <i class="fa-solid fa-rocket mr-1.5"></i> Piano d'Azione (5 Mosse)
                </button>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT CONTAINERS -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- SECTION 1: FLUSSI E MACRO MERCATO -->
        <section id="tab-flussi" class="tab-content block space-y-6">
            <div class="bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm">
                <div class="max-w-3xl">
                    <h2 class="text-2xl font-bold text-navy mb-2">Analisi dei Flussi Turistici e Posizionamento Strategico</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Porto Recanati rappresenta il polo ricettivo primario della Riviera del Conero meridionale. L'analisi quantitativa dei dati evidenzia un mercato stanziale ad alta marginalità operativa, caratterizzato da una permanenza media eccezionale che minimizza i costi variabili di pulizia e turnover.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
                    <div class="bg-warmbg p-4 rounded-lg border border-warmborder">
                        <div class="text-xs uppercase font-semibold text-gray-500">Arrivi Registrati (Gen-Set)</div>
                        <div class="text-2xl font-extrabold text-navy mt-1">71.294</div>
                        <div class="text-xs text-teal mt-1 font-medium"><i class="fa-solid fa-arrow-trend-up"></i> Solido bacino domestico</div>
                    </div>
                    <div class="bg-warmbg p-4 rounded-lg border border-warmborder">
                        <div class="text-xs uppercase font-semibold text-gray-500">Presenze Totali</div>
                        <div class="text-2xl font-extrabold text-navy mt-1">457.150</div>
                        <div class="text-xs text-teal mt-1 font-medium"><i class="fa-solid fa-check"></i> Superati livelli 2019 e 2022</div>
                    </div>
                    <div class="bg-warmbg p-4 rounded-lg border border-warmborder">
                        <div class="text-xs uppercase font-semibold text-gray-500">Permanenza Media (LOS)</div>
                        <div class="text-2xl font-extrabold text-amber mt-1">6,41 Notti</div>
                        <div class="text-xs text-amber-700 mt-1 font-medium"><i class="fa-solid fa-star"></i> Basso impatto costi turnover</div>
                    </div>
                    <div class="bg-warmbg p-4 rounded-lg border border-warmborder">
                        <div class="text-xs uppercase font-semibold text-gray-500">Turismo Estero</div>
                        <div class="text-2xl font-extrabold text-teal mt-1">+20% YoY</div>
                        <div class="text-xs text-teal-700 mt-1 font-medium"><i class="fa-solid fa-globe"></i> DACH e CEE in espansione</div>
                    </div>
                </div>
            </div>

            <!-- COMPARATIVE CHART & GEOGRAPHY -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Chart Container -->
                <div class="bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-navy mb-1">Confronto Permanenza Media (Notti) - Costa Marchigiana</h3>
                        <p class="text-xs text-gray-500 mb-4">Confronto tra le principali destinazioni balneari ed extra-urbane (Dati 2024).</p>
                    </div>
                    <div class="chart-container">
                        <canvas id="losChart"></canvas>
                    </div>
                    <p class="text-xs text-gray-500 mt-3 italic">
                        <strong>Nota per l'investitore:</strong> Una LOS di 6,41 notti garantisce un Net Operating Income (NOI) superiore rispettivo a città d'arte o poli d'affari (LOS ~2,0) tagliando del 60% le spese per ripasso biancheria e check-in.
                    </p>
                </div>

                <!-- Demographic & Geographic Breakdown -->
                <div class="bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-navy mb-3">Origine della Domanda & Profilo del Turista</h3>
                        <div class="space-y-4">
                            <div class="p-3 bg-blue-50/50 rounded-lg border border-blue-100">
                                <h4 class="font-semibold text-sm text-navy flex items-center">
                                    <i class="fa-solid fa-flag-usa mr-2 text-blue-600"></i> Mercato Nazionale (Domestico ~80%)
                                </h4>
                                <p class="text-xs text-gray-600 mt-1">
                                    Bacini prioritari: Lombardia, Emilia-Romagna, Umbria e Marche interne. Predilige la vacanza balneare stanziale nei mesi di Luglio e Agosto. Famiglie numerose e gruppi multifamiliari.
                                </p>
                            </div>

                            <div class="p-3 bg-amber-50/50 rounded-lg border border-amber-100">
                                <h4 class="font-semibold text-sm text-amber-900 flex items-center">
                                    <i class="fa-solid fa-earth-europe mr-2 text-amber-600"></i> Mercato Internazionale (+20% in crescita)
                                </h4>
                                <p class="text-xs text-gray-600 mt-1">
                                    Provenienze chiave: Germania, Austria, Svizzera (Area DACH) ed Est Europa (Ungheria, Croazia). Intercettano i mesi di spalla (Maggio, Giugno, Settembre) allungando la stagionalità operativa.
                                </p>
                            </div>

                            <div class="p-3 bg-teal-50/50 rounded-lg border border-teal-100">
                                <h4 class="font-semibold text-sm text-teal-900 flex items-center">
                                    <i class="fa-solid fa-bicycle mr-2 text-teal-600"></i> Trend Emergenti: Cicloturismo & Nomadismo
                                </h4>
                                <p class="text-xs text-gray-600 mt-1">
                                    Riconoscimento "Bandiera Gialla" FIAB e snodo della Ciclovia Adriatica (BI06). Cresce la domanda di cicloturisti primaverili ed autunnali in e-bike e nomadi digitali invernali.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: TIPOLOGIE IMMOBILIARI & CALCOLATORE ROI -->
        <section id="tab-tipologie" class="tab-content hidden space-y-6">
            <div class="bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm">
                <h2 class="text-2xl font-bold text-navy mb-2">Analisi delle Tipologie e Simulatori Finanziari</h2>
                <p class="text-gray-600 text-sm">
                    Analizza la distribuzione dei prezzi medi giornalieri (ADR) e dell'occupazione stimata per ciascun asset class immobiliare. Utilizza il simulatore interattivo per testare i rendimenti del tuo modello di business (Rent-to-Rent vs Buy-to-Let vs Property Management).
                </p>
            </div>

            <!-- ADR & OCCUPANCY CHART & TABLE -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Visualizing ADR Trends -->
                <div class="lg:col-span-2 bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                        <h3 class="text-lg font-bold text-navy">Proiezione Tariffe Medi Giornaliere (ADR 2025)</h3>
                        <select id="propertyTypeSelect" onchange="updateAdrChart()" class="text-xs bg-warmbg border border-warmborder rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-teal">
                            <option value="all">Confronta Tutte le Tipologie</option>
                            <option value="mono">Affittacamere / Monolocale</option>
                            <option value="bilo">Bilocale (4 Pax)</option>
                            <option value="trilo" selected>Trilocale (5-6 Pax - Target Elezione)</option>
                            <option value="quadri">Quadrilocale (7-8 Pax)</option>
                            <option value="villa">Villa (8+ Pax)</option>
                        </select>
                    </div>
                    <div class="chart-container">
                        <canvas id="adrChart"></canvas>
                    </div>
                </div>

                <!-- Property Summary Matrix -->
                <div class="bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-navy mb-3">Ranking Asset Class</h3>
                        <div class="space-y-3 text-xs">
                            <div class="p-3 rounded-lg border border-teal-200 bg-teal-50/40">
                                <div class="flex justify-between font-bold text-teal-900">
                                    <span>TRILOCALE (Centro/Mare)</span>
                                    <span class="bg-teal-600 text-white px-1.5 py-0.5 rounded text-[10px]">RATING #1</span>
                                </div>
                                <p class="text-gray-600 mt-1">Capienza 5-6 ospiti. Perfetto per famiglie estive, gruppi sportivi primaverili e smart worker invernali. Massimo Risk-Adjusted Return.</p>
                            </div>

                            <div class="p-3 rounded-lg border border-warmborder bg-gray-50">
                                <div class="flex justify-between font-bold text-gray-800">
                                    <span>BILOCALE</span>
                                    <span class="bg-gray-500 text-white px-1.5 py-0.5 rounded text-[10px]">RATING #2</span>
                                </div>
                                <p class="text-gray-600 mt-1">Capienza 4 ospiti. Ottimo per Rent-to-Rent ad alto turnover o coppie estero-spandenti. ADR Estate 130-160€.</p>
                            </div>

                            <div class="p-3 rounded-lg border border-warmborder bg-gray-50">
                                <div class="flex justify-between font-bold text-gray-800">
                                    <span>QUADRILOCALE / VILLA</span>
                                    <span class="bg-amber-600 text-white px-1.5 py-0.5 rounded text-[10px]">RATING #3</span>
                                </div>
                                <p class="text-gray-600 mt-1">Elevato scontrino in altissima stagione (250-700€/notte), ma occupazione annua più ridotta (35-45%). Richiede gestione complessa.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- INTERACTIVE ROI CALCULATOR -->
            <div class="bg-navy text-white p-6 rounded-xl shadow-lg border border-blue-900">
                <div class="max-w-3xl mb-6">
                    <h3 class="text-xl font-bold flex items-center text-white">
                        <i class="fa-solid fa-calculator text-amber-400 mr-2.5"></i> Calcolatore ROI & Conto Economico Previsionale 2025
                    </h3>
                    <p class="text-xs text-blue-200 mt-1">
                        Simula la redditività netta stimata inserendo i parametri del tuo investimento a Porto Recanati.
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <!-- Controls Column -->
                    <div class="lg:col-span-7 bg-blue-900/50 p-5 rounded-lg border border-blue-700/50 space-y-4 text-xs">
                        <!-- Model Selection -->
                        <div>
                            <label class="block font-semibold text-blue-200 mb-1">Modello d'Ingresso Strategico</label>
                            <select id="roiModel" onchange="calculateROI()" class="w-full bg-blue-950 border border-blue-700 text-white rounded p-2 focus:ring-1 focus:ring-amber">
                                <option value="r2r" selected>Rent-to-Rent (Sublocazione con Contratto 4+4)</option>
                                <option value="pm">Property Management (Fee di Gestione Conto Terzi)</option>
                                <option value="btl">Buy-to-Let (Acquisto Immobile e Messa a Reddito)</option>
                            </select>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <!-- Asset Type -->
                            <div>
                                <label class="block font-semibold text-blue-200 mb-1">Tipologia Asset</label>
                                <select id="roiType" onchange="calculateROI()" class="w-full bg-blue-950 border border-blue-700 text-white rounded p-2">
                                    <option value="bilo">Bilocale (4 Pax)</option>
                                    <option value="trilo" selected>Trilocale (6 Pax)</option>
                                    <option value="quadri">Quadrilocale (8 Pax)</option>
                                </select>
                            </div>
                            
                            <!-- Monthly Rent or Fee -->
                            <div id="costInputWrapper">
                                <label id="costInputLabel" class="block font-semibold text-blue-200 mb-1">Canone Annuo Locazione (€/anno)</label>
                                <input type="number" id="roiAnnualCost" value="8400" oninput="calculateROI()" class="w-full bg-blue-950 border border-blue-700 text-white rounded p-2">
                            </div>
                        </div>

                        <!-- Sliders -->
                        <div class="space-y-3">
                            <div>
                                <div class="flex justify-between text-blue-200 font-semibold mb-1">
                                    <span>ADR Medio Ponderato Stagionale (€):</span>
                                    <span id="adrVal" class="text-amber-400 font-bold">145 €</span>
                                </div>
                                <input type="range" id="roiAdr" min="80" max="280" value="145" step="5" oninput="calculateROI()" class="w-full accent-amber-400">
                            </div>

                            <div>
                                <div class="flex justify-between text-blue-200 font-semibold mb-1">
                                    <span>Tasso di Occupazione Annua (%):</span>
                                    <span id="occVal" class="text-teal-300 font-bold">58%</span>
                                </div>
                                <input type="range" id="roiOcc" min="30" max="80" value="58" step="1" oninput="calculateROI()" class="w-full accent-teal-400">
                            </div>
                        </div>
                    </div>

                    <!-- Results Column -->
                    <div class="lg:col-span-5 bg-warmcard text-darkneutral p-5 rounded-lg border border-warmborder flex flex-col justify-between shadow-inner">
                        <div>
                            <h4 class="font-bold text-navy text-sm uppercase border-b border-warmborder pb-2">Proiezione Finanziaria Annuo</h4>
                            
                            <div class="mt-4 space-y-2 text-xs">
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Notti Vendute Stimate:</span>
                                    <span id="resNotti" class="font-bold">211 notti</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="font-semibold text-navy">Fatturato Lordo STR:</span>
                                    <span id="resFatturato" class="font-bold text-navy">30.595 €</span>
                                </div>
                                <div class="flex justify-between text-red-600">
                                    <span>Costi Operativi & Commissioni OTA (~28%):</span>
                                    <span id="resCostiOp">-8.566 €</span>
                                </div>
                                <div class="flex justify-between text-gray-700" id="rowFixedCost">
                                    <span>Canone Locazione / Costo Capitale:</span>
                                    <span id="resCostoFisso">-8.400 €</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-warmborder">
                            <div class="text-xs uppercase text-gray-500 font-bold">Margine Operativo Netto (NOI)</div>
                            <div id="resNOI" class="text-3xl font-extrabold text-teal mt-1">13.629 €</div>
                            <div class="mt-2 text-[11px] bg-teal-50 text-teal-900 p-2 rounded border border-teal-200">
                                <span class="font-bold">ROI / Cash-on-Cash Stimato: </span><span id="resROI" class="font-extrabold">~85%</span>
                                <p class="text-[10px] text-gray-500 mt-0.5">Basato su un setup/capitale iniziale medio di 12.000 € (Rent-to-Rent).</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: VULNERABILITÀ & KILLER FEATURES -->
        <section id="tab-vulnerabilita" class="tab-content hidden space-y-6">
            <div class="bg-warmcard p-6 rounded-xl border border-warmborder shadow-sm">
                <h2 class="text-2xl font-bold text-navy mb-2">Punti Critici dei Competitor e Fattori Differenzianti</h2>
                <p class="text-gray-600 text-sm">
                    Oltre l'80% delle oltre 2.100 unità ricettive a Porto Recanati è gestita in modalità amatoriale. Ecco i principali "punti di dolore" lamentati dai turisti e come neutralizzarli per dominare le piattaforme.
                </p>
            </div>

            <!-- Matrix of Vulnerabilities vs Solutions -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Vulnerability 1: Railway Noise -->
                <div class="bg-warmcard p-5 rounded-xl border-l-4 border-red-500 shadow-sm space-y-3">
